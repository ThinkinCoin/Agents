# OpenAI API key (replace with your actual API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# X (formerly Twitter) API credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Agent configuration
AGENT_NAME=AgentSmith # without spaces
PROJECT=Think in Coin
TOKEN=NEURONS
HEARTBEAT_MS=10800000 # 3 hours in milliseconds (override to change heartbeat interval)
DISABLE_HEARTBEAT=1 # set to 1 to disable heartbeat in dev

